{
  "schemaVersion": 1,
  "id": "crystal_tweaks",
  "version": "${version}",
  "name": "Crystal Tweaks KoHs",
  "description": "Optimized End Crystal interactions with visual and sound customization.",
  "authors": [
    "zymekoh"
  ],
  "license": "MIT",
  "icon": "assets/crystal_tweaks/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.zymekoh.crystaltweaks.CrystalTweaksClient",
      "com.zymekoh.crystaltweaks.client.CrystalVisualInitializer"
    ],
    "modmenu": [
      "com.zymekoh.crystaltweaks.client.CrystalTweaksModMenu"
    ]
  },
  "mixins": [
    {
      "config": "crystal_tweaks.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_dependency}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": ">=${modmenu_version}"
  }
}
